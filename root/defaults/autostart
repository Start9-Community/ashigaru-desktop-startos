#!/usr/bin/env bash

set -eu

export NO_AT_BRIDGE=1

# Ashigaru keeps wallets, config and Tor state under this directory, on the
# main volume. It is passed with --dir because Java takes the default home
# from the passwd entry, not $HOME. Mainnet config lives at its root.
ashigaru_dir=/config/.ashigaru
config=$ashigaru_dir/config
mkdir -p "$ashigaru_dir"
chmod 700 "$ashigaru_dir"

# Updates arrive as new StartOS package versions; the in-app updater cannot
# replace the image. Answer its consent prompt "no" for the user, unless they
# have already answered it themselves.
if [ ! -s "$config" ]; then
  echo '{"updateCheckConsent": false}' > "$config"
elif [ "$(jq -r '.updateCheckConsent // "unset"' "$config" 2>/dev/null)" = unset ]; then
  tmp=$(mktemp "$config.XXXXXX")
  if jq '.updateCheckConsent = false' "$config" > "$tmp"; then
    mv "$tmp" "$config"
  else
    rm -f "$tmp"
  fi
fi
chmod 600 "$config"

# Kill any leftover Ashigaru processes before launching it in this D-Bus session.
pkill -f '/opt/Ashigaru' 2>/dev/null || true
sleep 1

# JavaFX's dropdowns and autocomplete lists are transparent windows with a
# drop shadow. Without a compositor their transparent margin paints white.
xcompmgr -n >/dev/null 2>&1 &

# Keep the main window filling the screen, which Selkies sizes to the browser.
# Openbox maximising does not stick: while a modal dialog is open JavaFX pins
# the main window's size hints to its unmaximised size, so the first-run tour
# blocks the maximise at map time and every later dialog undoes it. A plain
# resize to the screen survives both, so check every two seconds and resize
# when the window is off, unless a dialog currently pins it.
fit_main_window() {
  local wid screen sw sh ext l r t b want_w want_h geom max_w
  while true; do
    sleep 2
    wid=$(wmctrl -l 2>/dev/null | awk '/ Ashigaru Desktop [0-9]/ {print $1; exit}')
    [ -n "$wid" ] || continue
    screen=$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2; exit}')
    sw=${screen%x*} sh=${screen#*x}
    [ -n "$sw" ] && [ -n "$sh" ] || continue
    ext=$(xprop -id "$wid" _NET_FRAME_EXTENTS 2>/dev/null | sed -n 's/.*= //p' | tr -d ' ')
    IFS=, read -r l r t b <<< "${ext:-0,0,0,0}"
    want_w=$((sw - ${l:-0} - ${r:-0}))
    want_h=$((sh - ${t:-0} - ${b:-0}))
    geom=$(wmctrl -lG 2>/dev/null | awk -v id="$wid" '$1 == id {print $5, $6; exit}')
    [ "$geom" = "$want_w $want_h" ] && continue
    max_w=$(xprop -id "$wid" WM_NORMAL_HINTS 2>/dev/null | sed -n 's/.*maximum size: \([0-9]*\) by.*/\1/p')
    [ "${max_w:-0}" -ge "$want_w" ] || continue
    wmctrl -i -r "$wid" -e "0,0,0,$want_w,$want_h" 2>/dev/null || true
  done
}
fit_main_window &

# Relaunch Ashigaru whenever it exits, so quitting it never leaves the user
# looking at an empty desktop.
(
  while true; do
    /opt/Ashigaru/bin/Ashigaru --dir "$ashigaru_dir" || true
    sleep 2
  done
) &
